{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alianisreyesr.github.io/gxp-change-control/schemas/approval-in.json",
  "title": "ApprovalIn",
  "description": "JSON Schema for ApprovalIn (generated from Pydantic). Portfolio synthetic API only.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "role": { "type": "string", "minLength": 2, "maxLength": 80 },
    "decision": {
      "type": "string",
      "enum": ["approve", "reject", "request_info"]
    },
    "comment": {
      "anyOf": [
        { "type": "string", "maxLength": 2000 },
        { "type": "null" }
      ],
      "default": null
    },
    "actor": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    }
  },
  "required": ["role", "decision", "actor"],
  "allOf": [
    {
      "if": {
        "properties": { "decision": { "enum": ["reject", "request_info"] } },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "comment": { "type": "string", "minLength": 10, "maxLength": 2000 }
        },
        "required": ["comment"]
      }
    }
  ],
  "x-gxp-notes": {
    "actor_policy": "Shared-style ids rejected at runtime via Pydantic"
  }
}
